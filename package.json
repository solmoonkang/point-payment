{
  "name": "point-payment",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "description": "제로페이 스포츠상품권으로 킵페이 보험을 결제하는 로컬 시나리오 — 킵페이 서버 · 제로페이 서버 · 연동 계약 모노레포",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "check": "pnpm -r check",
    "test": "pnpm -r test",

    "keepay:dev": "pnpm --filter @point-payment/keepay dev",
    "keepay:check": "pnpm --filter @point-payment/keepay check",
    "keepay:test": "pnpm --filter @point-payment/keepay test",

    "zeropay:dev": "pnpm --filter @point-payment/zeropay dev",
    "zeropay:check": "pnpm --filter @point-payment/zeropay check",
    "zeropay:test": "pnpm --filter @point-payment/zeropay test",

    "contract:check": "pnpm --filter @point-payment/contract check",
    "contract:test": "pnpm --filter @point-payment/contract test"
  }
}
